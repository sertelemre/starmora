# Paste into Dokploy's Environment field. Do not commit actual values.
APP_DOMAIN=starmora.com
TRAEFIK_PREFIX=starmora
POSTGRES_USER=starmora
POSTGRES_DB=starmora_hd
# Generate on your machine: openssl rand -hex 32
POSTGRES_PASSWORD=
# Obtain on the Dokploy host:
# docker network inspect dokploy-network --format '{{range .IPAM.Config}}{{println .Subnet}}{{end}}'
# Choose the IPv4 subnet shown above (not an assumed/default subnet).
TRUSTED_PROXY_CIDR=
